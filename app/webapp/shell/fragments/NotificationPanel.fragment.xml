<!--
  Shell notification center (§13) with two tabs:
  - Notifications: events raised in the app through the NotificationCenter (e.g. retry outcomes),
    severity-prioritised, each dismissible, plus clear-all.
  - What's new: the latest changes to the portal (shell/updates/ReleaseNotes), new ones marked
    unread until the panel closes; "See all updates" opens the Updates page.
  Both read the global `notifications` model and the `shell` view model.
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Popover
    title="{i18n>shell.notifications}"
    placement="Bottom"
    contentWidth="28rem"
    contentHeight="28rem"
    afterClose=".onNotificationPanelClose">
    <subHeader>
      <Toolbar>
        <SegmentedButton
          selectedKey="{shell>/panel/tab}"
          selectionChange=".onNotificationTabChange"
          width="100%">
          <items>
            <SegmentedButtonItem
              key="notifications"
              text="{= ${i18n>shell.notifications.tab} + (${notifications>/unreadCount} > 0 ? ' (' + ${notifications>/unreadCount} + ')' : '') }" />
            <SegmentedButtonItem
              key="updates"
              text="{= ${i18n>shell.updates.tab} + (${shell>/panel/updatesUnseen} > 0 ? ' (' + ${shell>/panel/updatesUnseen} + ')' : '') }" />
          </items>
        </SegmentedButton>
      </Toolbar>
    </subHeader>

    <List
      items="{notifications>/items}"
      noDataText="{i18n>shell.notifications.empty}"
      visible="{= ${shell>/panel/tab} === 'notifications' }">
      <NotificationListItem
        title="{notifications>title}"
        description="{notifications>description}"
        datetime="{notifications>timestamp}"
        priority="{= ${notifications>severity} === 'CRITICAL' || ${notifications>severity} === 'ERROR' ? 'High' : (${notifications>severity} === 'WARNING' ? 'Medium' : 'Low') }"
        showCloseButton="true"
        close=".onNotificationDismiss" />
    </List>

    <List
      items="{shell>/panel/updates}"
      noDataText="{i18n>shell.updates.empty}"
      visible="{= ${shell>/panel/tab} === 'updates' }">
      <NotificationListItem
        title="{shell>title}"
        description="{shell>description}"
        authorName="{shell>label}"
        datetime="{shell>dateText}"
        unread="{shell>unseen}"
        priority="None"
        truncate="false"
        showCloseButton="false"
        type="{= ${shell>route} ? 'Active' : 'Inactive' }"
        press=".onUpdatePress" />
    </List>

    <footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button
          text="{i18n>shell.notifications.clear}"
          icon="sap-icon://decline"
          type="Transparent"
          visible="{= ${shell>/panel/tab} === 'notifications' }"
          press=".onNotificationClear" />
        <Button
          text="{i18n>shell.updates.seeAll}"
          icon="sap-icon://feed"
          type="Transparent"
          visible="{= ${shell>/panel/tab} === 'updates' }"
          press=".onSeeAllUpdates" />
      </OverflowToolbar>
    </footer>
  </Popover>
</core:FragmentDefinition>
