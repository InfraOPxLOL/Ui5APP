<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <!--
    Asked before retrying a JMS-framework message whose queue neither the ingress header nor a queue
    consumer flow names: the operator picks one of the framework's processing queues.
  -->
  <Dialog
    id="chooseQueueDialog"
    title="{i18n>choose.title}"
    contentWidth="30rem"
    type="Message">
    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="{view>/choose/text}" class="sapUiSmallMarginBottom" />
        <Label text="{i18n>target.choose}" labelFor="chooseQueueSelect" required="true" />
        <Select
          id="chooseQueueSelect"
          forceSelection="false"
          selectedKey="{view>/choose/target}"
          items="{view>/choose/options}"
          width="100%">
          <core:Item key="{view>}" text="{view>}" />
        </Select>
      </VBox>
    </content>
    <beginButton>
      <Button
        text="{i18n>action.retry}"
        type="Emphasized"
        enabled="{= !!${view>/choose/target} }"
        press=".onChooseQueueConfirm" />
    </beginButton>
    <endButton>
      <Button text="{i18n>action.cancel}" press=".onChooseQueueCancel" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
