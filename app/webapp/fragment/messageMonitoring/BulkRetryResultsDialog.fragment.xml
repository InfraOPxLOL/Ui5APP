<!--
  Bulk JMS retry results dialog (§ JMS Retry — "Retry Selected"). Shows the per-message outcome of a
  bulk retry, rather than only an aggregate toast — each row's real accepted/failed state, never
  fabricated. Bound to a dedicated `bulkRetry` model set by `List.controller.ts`.
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout">
  <Dialog
    title="{i18n>investigation.retry.bulk.resultsTitle}"
    contentWidth="32rem"
    busy="{bulkRetry>/busy}"
    busyIndicatorDelay="0">
    <content>
      <l:VerticalLayout width="100%" class="sapUiSmallMargin">
        <Text text="{bulkRetry>/summary}" class="sapUiSmallMarginBottom" />
        <List items="{bulkRetry>/results}" noDataText=" ">
          <StandardListItem
            title="{bulkRetry>messageId}"
            description="{bulkRetry>note}"
            icon="{= ${bulkRetry>accepted} ? 'sap-icon://accept' : 'sap-icon://error' }"
            iconInset="false"
            infoState="{= ${bulkRetry>accepted} ? 'Success' : 'Error' }"
            info="{= ${bulkRetry>accepted} ? ${i18n>investigation.retry.bulk.rowAccepted} : ${i18n>investigation.retry.bulk.rowFailed} }" />
        </List>
      </l:VerticalLayout>
    </content>
    <endButton>
      <Button text="{i18n>action.close}" press=".onBulkRetryResultsClose" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
