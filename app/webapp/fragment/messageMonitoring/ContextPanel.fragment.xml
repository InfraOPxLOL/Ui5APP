<!--
  Investigation Panel / Context Panel (§ Investigation Panel) — the workspace's right pane.

  Populated by selecting a message: status/health/summary, environment, a best-effort queue
  reference, a certificate watch, runtime reference, related messages (by dimension) and the
  metadata-driven action list. No payload here — payload has its own future workspace (Phase 10).
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout">
  <ScrollContainer
    height="100%"
    vertical="true"
    class="investigationContextScroll"
    busy="{view>/context/busy}"
    busyIndicatorDelay="0">
    <l:VerticalLayout width="100%" class="sapUiSmallMargin">

      <MessageStrip
        visible="{= ${view>/selectedMessageId} === '' }"
        text="{i18n>investigation.context.empty}"
        type="Information"
        showIcon="true" />

      <VBox visible="{= ${view>/selectedMessageId} !== '' }" width="100%">
        <items>

          <!-- Status / health / summary -->
          <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
            <items>
              <ObjectStatus
                text="{view>/context/context/humanReadableStatus}"
                state="{ path: 'view>/context/context/severity', formatter: '.formatSeverityState' }"
                icon="{ path: 'view>/context/context/health', formatter: '.formatHealthIcon' }" />
              <ToggleButton
                icon="sap-icon://favorite"
                press=".onToggleBookmark"
                tooltip="{i18n>investigation.bookmark}" />
            </items>
          </HBox>
          <Text text="{view>/context/context/summary}" class="sapUiTinyMarginBottom" />

          <!-- Metadata / environment -->
          <Title text="{i18n>investigation.context.metadata}" level="H5" />
          <ObjectAttribute title="{i18n>column.environment}" text="{view>/context/context/environment}" />
          <ObjectAttribute title="{i18n>column.tenant}" text="{view>/context/context/tenantId}" />

          <!-- Runtime -->
          <Title
            text="{i18n>investigation.context.runtime}"
            level="H5"
            class="sapUiSmallMarginTop"
            visible="{= ${view>/context/context/runtime} !== undefined }" />
          <ObjectListItem
            visible="{= ${view>/context/context/runtime} !== undefined }"
            title="{view>/context/context/runtime/name}"
            type="Active"
            press=".onOpenRuntimeFromContext">
            <firstStatus>
              <ObjectStatus
                text="{view>/context/context/runtime/humanReadableStatus}"
                state="{ path: 'view>/context/context/runtime/health', formatter: '.formatHealthState' }" />
            </firstStatus>
          </ObjectListItem>

          <!-- Queue reference -->
          <Title
            text="{i18n>investigation.context.queue}"
            level="H5"
            class="sapUiSmallMarginTop"
            visible="{= ${view>/context/context/queueReference} !== undefined }" />
          <ObjectListItem
            visible="{= ${view>/context/context/queueReference} !== undefined }"
            title="{view>/context/context/queueReference/displayName}"
            number="{view>/context/context/queueReference/retryCount}"
            numberUnit="{i18n>investigation.context.retries}"
            type="Active"
            press=".onOpenQueueFromContext" />

          <!-- Certificate watch -->
          <Title
            text="{i18n>investigation.context.certificates}"
            level="H5"
            class="sapUiSmallMarginTop"
            visible="{= ${view>/context/context/certificateWatch}.length > 0 }" />
          <List items="{view>/context/context/certificateWatch}" noDataText=" ">
            <StandardListItem
              title="{view>alias}"
              description="{view>daysRemaining} {i18n>investigation.context.daysLeft}"
              infoState="{ path: 'view>health', formatter: '.formatHealthState' }"
              type="Active"
              press=".onOpenCertificateFromContext" />
          </List>

          <!-- Recent notifications -->
          <Title
            text="{i18n>investigation.context.notifications}"
            level="H5"
            class="sapUiSmallMarginTop"
            visible="{= ${view>/context/context/recentNotifications}.length > 0 }" />
          <List items="{view>/context/context/recentNotifications}" noDataText=" ">
            <StandardListItem
              title="{view>title}"
              description="{view>description}"
              infoState="{ path: 'view>severity', formatter: '.formatSeverityState' }"
              type="Active"
              press=".onOpenAlertFromContext" />
          </List>

          <!-- Related messages, grouped by dimension -->
          <Title text="{i18n>investigation.context.related}" level="H5" class="sapUiSmallMarginTop" />
          <List items="{view>/context/related}" noDataText="{i18n>investigation.context.noRelated}">
            <CustomListItem>
              <l:VerticalLayout width="100%" class="investigationRelatedGroup">
                <Label text="{view>value}" design="Bold" class="sapUiTinyMarginTop" />
                <List items="{view>items}" noDataText=" ">
                  <StandardListItem
                    title="{view>integrationFlow}"
                    description="{view>sender} → {view>receiver}"
                    infoState="{ path: 'view>severity', formatter: '.formatSeverityState' }"
                    info="{view>humanReadableStatus}"
                    type="Active"
                    press=".onOpenRelatedMessage" />
                </List>
              </l:VerticalLayout>
            </CustomListItem>
          </List>

          <!-- Actions -->
          <Title text="{i18n>investigation.context.actions}" level="H5" class="sapUiSmallMarginTop" />
          <List items="{view>/actions}" noDataText=" ">
            <StandardListItem
              title="{view>title}"
              icon="{view>icon}"
              type="Active"
              press=".onContextActionPress" />
          </List>

        </items>
      </VBox>

    </l:VerticalLayout>
  </ScrollContainer>
</core:FragmentDefinition>
