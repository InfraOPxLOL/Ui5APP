<mvc:View
  controllerName="com.middlewareops.integrationportal.controller.coeRouter.RouteWizard"
  height="100%"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">
  <Page
    id="page"
    title="{i18n>hub.jmsEntry.title}"
    showNavButton="true"
    navButtonPress=".onNavBackToHub"
    navButtonTooltip="{i18n>hub.flow.back}"
    class="integrationPortalModulePage"
    busy="{view>/busy}"
    busyIndicatorDelay="0">
    <content>
      <Wizard
        id="wizard"
        class="sapUiResponsiveMargin"
        width="auto"
        finishButtonText="{i18n>coeRouter.deploy.button}"
        complete=".onDeploy">

        <!-- Step 1: Ingress — IDoc control record parsing, or direct manual entry -->
        <WizardStep
          title="{i18n>coeRouter.step.ingress}"
          icon="sap-icon://document-text"
          validated="{view>/idocParsed}">
          <VBox class="sapUiSmallMargin">
            <Label text="{i18n>coeRouter.ingress.paste}" labelFor="idocInput" />
            <TextArea
              id="idocInput"
              value="{view>/idoc/raw}"
              rows="10"
              width="100%"
              growing="false"
              placeholder="{i18n>coeRouter.ingress.placeholder}" />
            <Button
              text="{i18n>coeRouter.ingress.parse}"
              icon="sap-icon://synchronize"
              type="Emphasized"
              press=".onParseIdoc"
              class="sapUiSmallMarginTop" />
            <MessageStrip
              class="sapUiSmallMarginTop"
              text="{view>/parseError}"
              type="Error"
              showIcon="true"
              visible="{= ${view>/parseError} !== '' }" />

            <form:SimpleForm
              editable="true"
              layout="ColumnLayout"
              title="{i18n>coeRouter.ingress.extracted}"
              class="sapUiSmallMarginTop">
              <form:content>
                <Label text="{i18n>coeRouter.field.sndprn}" />
                <Input
                  value="{view>/idoc/sndprn}"
                  liveChange=".onIdentifierEdited"
                  valueState="{= ${view>/idoc/sndprn} === '' ? 'Error' : 'None' }"
                  placeholder="SENDER_SYS" />
                <Label text="{i18n>coeRouter.field.rcvprn}" />
                <Input
                  value="{view>/idoc/rcvprn}"
                  liveChange=".onIdentifierEdited"
                  valueState="{= ${view>/idoc/rcvprn} === '' ? 'Error' : 'None' }"
                  placeholder="RECEIVER_SYS" />
                <Label text="{i18n>coeRouter.field.mestyp}" />
                <Input
                  value="{view>/idoc/mestyp}"
                  liveChange=".onIdentifierEdited"
                  valueState="{= ${view>/idoc/mestyp} === '' ? 'Error' : 'None' }"
                  placeholder="ORDERS" />
                <Label text="{i18n>coeRouter.field.idoctyp}" />
                <Input value="{view>/idoc/idoctyp}" liveChange=".onIdentifierEdited" placeholder="ORDERS05" />
                <Label text="{i18n>coeRouter.field.sndpor}" />
                <Input value="{view>/idoc/sndpor}" liveChange=".onIdentifierEdited" placeholder="SAPPRD" />
                <Label text="{i18n>coeRouter.field.rcvpor}" />
                <Input value="{view>/idoc/rcvpor}" liveChange=".onIdentifierEdited" placeholder="A000000123" />
                <Label text="{i18n>coeRouter.field.routeKey}" />
                <ObjectStatus text="{view>/idoc/routeKey}" state="Information" />
              </form:content>
            </form:SimpleForm>
            <MessageStrip
              class="sapUiSmallMarginTop"
              text="{i18n>coeRouter.ingress.manualHint}"
              type="Information"
              showIcon="true" />
          </VBox>
        </WizardStep>

        <!-- Step 2: Agreement collision check -->
        <WizardStep
          title="{i18n>coeRouter.step.agreement}"
          icon="sap-icon://chain-link"
          validated="{= ${view>/collision} !== null }">
          <VBox class="sapUiSmallMargin">
            <MessageStrip
              text="{i18n>coeRouter.agreement.info}"
              type="Information"
              showIcon="true"
              class="sapUiSmallMarginBottom" />
            <form:SimpleForm editable="true" layout="ColumnLayout">
              <form:content>
                <Label text="{i18n>coeRouter.field.targetPid}" />
                <Input
                  value="{view>/target/targetPid}"
                  valueState="{= ${view>/target/targetPid} === '' ? 'Error' : 'None' }"
                  placeholder="PID_SALESFORCE_CORE"
                  showSuggestion="true"
                  autocomplete="true"
                  suggestionItems="{view>/partnerSuggestions}">
                  <suggestionItems>
                    <core:ListItem text="{view>pid}" additionalText="{view>info}" />
                  </suggestionItems>
                </Input>
              </form:content>
            </form:SimpleForm>
            <Button
              text="{i18n>coeRouter.agreement.check}"
              icon="sap-icon://search"
              type="Emphasized"
              press=".onCheckAgreement"
              class="sapUiSmallMarginTop" />
            <MessageStrip
              class="sapUiSmallMarginTop"
              text="{i18n>coeRouter.agreement.normal}"
              type="Success"
              showIcon="true"
              visible="{= ${view>/collision} !== null &amp;&amp; ${view>/collision/track} === 'normal' }" />
            <MessageStrip
              class="sapUiSmallMarginTop"
              text="{= ${i18n>coeRouter.agreement.ruleset} + ' ' + (${view>/collision/existingTargetPid} || '') }"
              type="Warning"
              showIcon="true"
              visible="{= ${view>/collision} !== null &amp;&amp; ${view>/collision/track} === 'ruleset' }" />
          </VBox>
        </WizardStep>

        <!-- Step 3: Target configuration + advanced settings -->
        <WizardStep
          title="{i18n>coeRouter.step.config}"
          icon="sap-icon://settings"
          validated="{= ${view>/target/targetQueue} !== '' &amp;&amp; ${view>/target/endpointUri}.indexOf('/') === 0 }">
          <VBox class="sapUiSmallMargin">
            <form:SimpleForm
              editable="true"
              layout="ColumnLayout"
              title="{i18n>coeRouter.config.title}">
              <form:content>
                <Label text="{i18n>coeRouter.field.targetPid}" />
                <Text text="{view>/target/targetPid}" />
                <Label text="{i18n>coeRouter.field.routeKey}" />
                <Text text="{view>/idoc/routeKey}" />
                <Label text="{i18n>coeRouter.field.targetQueue}" />
                <Input
                  value="{view>/target/targetQueue}"
                  valueState="{= ${view>/target/targetQueue} === '' ? 'Error' : 'None' }"
                  placeholder="Common_JMS_ID_SFDC_Orders" />
                <Label text="{i18n>coeRouter.queueBuilder.label}" />
                <Select
                  selectedKey="{view>/queueBuilder/region}"
                  width="12rem"
                  items="{view>/regions}">
                  <core:Item key="{view>key}" text="{view>text}" />
                </Select>
                <Select
                  selectedKey="{view>/queueBuilder/priority}"
                  width="6rem"
                  items="{view>/priorities}">
                  <core:Item key="{view>}" text="{view>}" />
                </Select>
                <Button
                  text="{i18n>coeRouter.queueBuilder.build}"
                  icon="sap-icon://create"
                  press=".onBuildQueueName" />
                <Label text="{i18n>coeRouter.field.endpointUri}" />
                <Input
                  value="{view>/target/endpointUri}"
                  valueState="{= ${view>/target/endpointUri}.indexOf('/') === 0 ? 'None' : 'Error' }"
                  placeholder="/cxf/salesforce/inbound/orders" />
              </form:content>
            </form:SimpleForm>

            <IconTabBar expandable="false" class="sapUiSmallMarginTop">
              <items>
                <!-- Tab A: Custom Mapping Exits -->
                <IconTabFilter text="{i18n>coeRouter.tab.mapping}" icon="sap-icon://split">
                  <form:SimpleForm editable="true" layout="ColumnLayout">
                    <form:content>
                      <Label text="{i18n>coeRouter.mapping.enable}" />
                      <Switch state="{view>/advanced/customMapping/enabled}" />
                      <Label text="{i18n>coeRouter.mapping.condition}" />
                      <Select
                        selectedKey="{view>/advanced/customMapping/condition}"
                        enabled="{view>/advanced/customMapping/enabled}">
                        <core:Item key="pre" text="{i18n>coeRouter.mapping.pre}" />
                        <core:Item key="post" text="{i18n>coeRouter.mapping.post}" />
                      </Select>
                      <Label text="{i18n>coeRouter.mapping.address}" />
                      <Input
                        value="{view>/advanced/customMapping/address}"
                        enabled="{view>/advanced/customMapping/enabled}"
                        valueState="{= !${view>/advanced/customMapping/enabled} || ${view>/advanced/customMapping/address}.indexOf('/') === 0 ? 'None' : 'Error' }"
                        placeholder="/Map/PreJMS/Orders" />
                    </form:content>
                  </form:SimpleForm>
                </IconTabFilter>

                <!-- Tab B: Alerting Governance -->
                <IconTabFilter text="{i18n>coeRouter.tab.alerting}" icon="sap-icon://bell">
                  <form:SimpleForm editable="true" layout="ColumnLayout">
                    <form:content>
                      <Label text="{i18n>coeRouter.alerting.to}" />
                      <Input value="{view>/advanced/alerting/to}" type="Email" placeholder="ops@example.com" />
                      <Label text="{i18n>coeRouter.alerting.cc}" />
                      <Input value="{view>/advanced/alerting/cc}" type="Email" />
                      <Label text="{i18n>coeRouter.alerting.bcc}" />
                      <Input value="{view>/advanced/alerting/bcc}" type="Email" />
                      <Label text="{i18n>coeRouter.alerting.subject}" />
                      <Input value="{view>/advanced/alerting/subject}" />
                      <Label text="{i18n>coeRouter.alerting.maxRetries}" />
                      <StepInput value="{view>/advanced/alerting/maxRetries}" min="0" max="5" width="8rem" />
                    </form:content>
                  </form:SimpleForm>
                </IconTabFilter>

                <!-- Tab C: Optimization & Tracing -->
                <IconTabFilter text="{i18n>coeRouter.tab.optimization}" icon="sap-icon://performance">
                  <form:SimpleForm editable="true" layout="ColumnLayout">
                    <form:content>
                      <Label text="{i18n>coeRouter.opt.priority}" />
                      <Select selectedKey="{view>/advanced/optimization/priority}" items="{view>/priorities}">
                        <core:Item key="{view>}" text="{view>}" />
                      </Select>
                      <Label text="{i18n>coeRouter.opt.sync}" />
                      <Switch state="{view>/advanced/optimization/sync}" />
                      <Label text="{i18n>coeRouter.opt.forceCache}" />
                      <Switch state="{view>/advanced/optimization/forceCacheRefresh}" />
                    </form:content>
                  </form:SimpleForm>
                </IconTabFilter>
              </items>
            </IconTabBar>
          </VBox>
        </WizardStep>

        <!-- Step 4: Disambiguation Rule (author a Binary Parameter rule for a ruleset collision) -->
        <WizardStep title="{i18n>coeRouter.step.rule}" icon="sap-icon://tree" validated="true">
          <VBox class="sapUiSmallMargin">
            <MessageStrip
              text="{= ${view>/collision/track} === 'ruleset' ? ${i18n>coeRouter.rule.needed} : ${i18n>coeRouter.rule.optional} }"
              type="{= ${view>/collision/track} === 'ruleset' ? 'Warning' : 'Information' }"
              showIcon="true"
              class="sapUiSmallMarginBottom" />
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
              <Switch state="{view>/ruleStepEnabled}" />
              <Label text="{i18n>coeRouter.rule.authorNow}" class="sapUiSmallMarginBegin" />
            </HBox>
            <VBox visible="{view>/ruleStepEnabled}">
              <MessageStrip
                text="{= ${i18n>coeRouter.rule.storeHint} + ' ' + ${view>/ruleEditor/pid} }"
                type="Information"
                showIcon="true"
                class="sapUiTinyMarginBottom" />
              <core:Fragment
                fragmentName="com.middlewareops.integrationportal.view.coeRuleBuilder.RuleEditorContent"
                type="XML" />
            </VBox>
          </VBox>
        </WizardStep>

        <!-- Step 5: Review & Deploy -->
        <WizardStep title="{i18n>coeRouter.step.review}" icon="sap-icon://sys-enter-2" validated="true">
          <VBox class="sapUiSmallMargin">
            <form:SimpleForm editable="false" layout="ColumnLayout" title="{i18n>coeRouter.review.title}">
              <form:content>
                <Label text="{i18n>coeRouter.field.targetPid}" />
                <Text text="{view>/target/targetPid}" />
                <Label text="{i18n>coeRouter.field.routeKey}" />
                <Text text="{view>/idoc/routeKey}" />
                <Label text="{i18n>coeRouter.field.targetQueue}" />
                <Text text="{view>/target/targetQueue}" />
                <Label text="{i18n>coeRouter.field.endpointUri}" />
                <Text text="{view>/target/endpointUri}" />
                <Label text="{i18n>coeRouter.review.track}" />
                <Text text="{view>/collision/track}" />
              </form:content>
            </form:SimpleForm>
            <MessageStrip
              class="sapUiSmallMarginTop"
              text="{i18n>coeRouter.review.hint}"
              type="Information"
              showIcon="true" />

            <VBox visible="{= ${view>/deployResult} !== null }" class="sapUiSmallMarginTop">
              <Title text="{i18n>coeRouter.review.result}" level="H4" class="sapUiSmallMarginBottom" />
              <List items="{view>/deployResult/created}" noDataText="{i18n>coeRouter.review.noResult}">
                <StandardListItem
                  title="{view>pid} · {view>id}"
                  info="{view>status}"
                  infoState="{= ${view>status} === 'ok' ? 'Success' : 'Error' }"
                  description="{view>error}"
                  icon="{= ${view>status} === 'ok' ? 'sap-icon://sys-enter-2' : 'sap-icon://error' }" />
              </List>
              <VBox
                visible="{= !!${view>/deployResult/rulesetFollowUps} &amp;&amp; ${view>/deployResult/rulesetFollowUps}.length > 0 }"
                class="sapUiMediumMarginTop">
                <Title text="{i18n>coeRouter.review.warnings}" level="H4" class="sapUiSmallMarginBottom" />
                <VBox items="{view>/deployResult/rulesetFollowUps}">
                  <HBox
                    class="sapUiSmallMarginBottom"
                    alignItems="Center"
                    wrap="Wrap"
                    justifyContent="SpaceBetween">
                    <HBox alignItems="Center" wrap="Wrap">
                      <core:Icon src="sap-icon://warning" color="Critical" class="sapUiTinyMarginEnd" />
                      <Text text="{i18n>coeRouter.review.followUpHint}" class="sapUiTinyMarginEnd" />
                      <ObjectStatus text="{view>ruleName}" state="Warning" class="sapUiTinyMarginEnd" />
                      <Text text="{i18n>coeRouter.review.followUpUnder}" class="sapUiTinyMarginEnd" />
                      <ObjectStatus text="{view>storePid}" state="Information" />
                    </HBox>
                    <Button
                      text="{i18n>coeRouter.review.openRuleBuilder}"
                      type="Emphasized"
                      icon="sap-icon://arrow-right"
                      iconFirst="false"
                      press=".onOpenRuleBuilder" />
                  </HBox>
                </VBox>
              </VBox>
            </VBox>
          </VBox>
        </WizardStep>
      </Wizard>
    </content>
  </Page>
</mvc:View>
