<mvc:View
  controllerName="com.middlewareops.integrationportal.controller.roleView.List"
  height="100%"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:ip="com.middlewareops.integrationportal.library.controls">
  <Page
    id="page"
    title="{i18n>title}"
    class="integrationPortalModulePage">
    <headerContent>
      <Button
        icon="sap-icon://refresh"
        tooltip="{i18n>action.refresh}"
        press=".onRefresh" />
      <Button
        icon="sap-icon://excel-attachment"
        tooltip="{i18n>action.export}"
        press=".onExport" />
    </headerContent>
    <content>
      <ip:ConfigurableTable
        id="table"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
        growing="true"
        growingThreshold="50"
        mode="SingleSelectMaster"
        sticky="ColumnHeaders,HeaderToolbar" />
    </content>
  </Page>
</mvc:View>
