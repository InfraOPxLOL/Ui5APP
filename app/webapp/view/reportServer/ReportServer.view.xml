<mvc:View
  controllerName="com.middlewareops.integrationportal.controller.reportServer.ReportServer"
  height="100%"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout">
  <Page
    id="page"
    class="integrationPortalModulePage reportServerPage">
    <customHeader>
      <OverflowToolbar class="reportServerHeader">
        <Title text="{i18n>title}" level="H2" />
        <!-- Saved views: the user's own filter sets, the standard view first. -->
        <VariantManagement
          id="views"
          items="{view>/views}"
          selectedKey="{view>/selectedViewKey}"
          defaultKey="{view>/defaultViewKey}"
          modified="{view>/viewModified}"
          supportFavorites="false"
          supportPublic="false"
          supportContexts="false"
          supportApplyAutomatically="false"
          supportExecuteOnSelection="false"
          select=".onViewSelect"
          save=".onViewSave"
          manage=".onViewManage"
          class="sapUiSmallMarginBegin">
          <items>
            <VariantItem key="{view>key}" title="{view>title}" rename="{view>rename}" remove="{view>remove}" />
          </items>
        </VariantManagement>
        <ToolbarSpacer />
        <Button
          icon="sap-icon://share-2"
          tooltip="{i18n>action.shareView}"
          press=".onShareView" />
        <Button
          icon="sap-icon://refresh"
          tooltip="{i18n>action.refresh}"
          press=".onRefresh" />
        <Button
          icon="sap-icon://excel-attachment"
          tooltip="{i18n>action.export}"
          enabled="{= ${view>/items}.length > 0 }"
          press=".onExport" />
      </OverflowToolbar>
    </customHeader>
    <content>
      <VBox class="reportServerBody" height="100%">

        <MessageStrip
          text="{view>/unavailableMessage}"
          type="Warning"
          showIcon="true"
          visible="{= ${view>/unavailableMessage} !== '' }"
          class="sapUiSmallMargin" />

        <!-- Search: time window and the common fields; "More filters" opens the advanced fields. -->
        <FlexBox
          wrap="Wrap"
          alignItems="End"
          class="reportServerFilters"
          visible="{= ${view>/unavailableMessage} === '' }">
          <VBox>
            <Label text="{i18n>filter.timeWindow}" labelFor="timePreset" />
            <Select
              id="timePreset"
              selectedKey="{view>/filters/timePreset}"
              items="{view>/timePresets}"
              showSecondaryValues="true"
              width="12rem"
              change=".onTimePresetChange">
              <core:ListItem key="{view>key}" text="{view>text}" additionalText="{view>code}" />
            </Select>
          </VBox>
          <VBox visible="{= ${view>/filters/timePreset} === 'custom' }">
            <Label text="{i18n>filter.dateFrom}" labelFor="dateFrom" />
            <DateTimePicker id="dateFrom" dateValue="{view>/filters/dateFrom}" width="13rem" />
          </VBox>
          <VBox visible="{= ${view>/filters/timePreset} === 'custom' }">
            <Label text="{i18n>filter.dateTo}" labelFor="dateTo" />
            <DateTimePicker id="dateTo" dateValue="{view>/filters/dateTo}" width="13rem" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.senderPartner}" labelFor="senderPartner" />
            <Input id="senderPartner" value="{view>/filters/senderPartner}" width="11rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.receiverPartner}" labelFor="receiverPartner" />
            <Input id="receiverPartner" value="{view>/filters/receiverPartner}" width="11rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.documentStandard}" labelFor="documentStandard" />
            <Select id="documentStandard" selectedKey="{view>/filters/documentStandard}" width="9rem">
              <core:Item key="" text="{i18n>filter.any}" />
              <core:Item key="ASC-X12" text="ASC X12" />
              <core:Item key="UN-EDIFACT" text="UN/EDIFACT" />
            </Select>
          </VBox>
          <VBox>
            <Label text="{i18n>filter.messageType}" labelFor="messageType" />
            <Input id="messageType" value="{view>/filters/messageType}" width="7rem" submit=".onSearch" placeholder="850" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.controlNumber}" labelFor="controlNumber" />
            <Input id="controlNumber" value="{view>/filters/controlNumber}" width="9rem" submit=".onSearch" />
          </VBox>
          <HBox class="reportServerFilterActions" alignItems="Center">
            <Button text="{i18n>action.search}" type="Emphasized" icon="sap-icon://search" press=".onSearch" />
            <Button text="{i18n>action.clear}" type="Transparent" press=".onClear" class="sapUiTinyMarginBegin" />
            <ToggleButton
              text="{= ${view>/advancedCount} > 0 ? ${i18n>filter.more} + ' (' + ${view>/advancedCount} + ')' : ${i18n>filter.more} }"
              icon="sap-icon://filter"
              type="Transparent"
              pressed="{view>/advanced}"
              class="sapUiTinyMarginBegin" />
          </HBox>
        </FlexBox>

        <!-- Advanced search -->
        <FlexBox
          wrap="Wrap"
          alignItems="End"
          class="reportServerFilters reportServerAdvanced"
          visible="{= ${view>/advanced} &amp;&amp; ${view>/unavailableMessage} === '' }">
          <VBox>
            <Label text="{i18n>filter.interchangeId}" labelFor="interchangeId" />
            <Input id="interchangeId" value="{view>/filters/interchangeId}" width="14rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.mplId}" labelFor="mplId" />
            <Input id="mplId" value="{view>/filters/mplId}" width="14rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.direction}" labelFor="direction" />
            <ComboBox id="direction" value="{view>/filters/direction}" width="9rem">
              <core:Item key="INBOUND" text="INBOUND" />
              <core:Item key="OUTBOUND" text="OUTBOUND" />
            </ComboBox>
          </VBox>
          <VBox>
            <Label text="{i18n>filter.agreement}" labelFor="agreement" />
            <Input id="agreement" value="{view>/filters/agreement}" width="12rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.transactionType}" labelFor="transactionType" />
            <Input id="transactionType" value="{view>/filters/transactionType}" width="12rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.interchangeName}" labelFor="interchangeName" />
            <Input id="interchangeName" value="{view>/filters/interchangeName}" width="12rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.systemId}" labelFor="systemId" />
            <Input id="systemId" value="{view>/filters/systemId}" width="10rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.adapterType}" labelFor="adapterType" />
            <ComboBox id="adapterType" value="{view>/filters/adapterType}" width="9rem">
              <core:Item key="AS2" text="AS2" />
              <core:Item key="AS4" text="AS4" />
              <core:Item key="SFTP" text="SFTP" />
              <core:Item key="HTTP" text="HTTP" />
              <core:Item key="IDOC" text="IDOC" />
              <core:Item key="SOAP" text="SOAP" />
              <core:Item key="ProcessDirect" text="ProcessDirect" />
            </ComboBox>
          </VBox>
          <VBox>
            <Label text="{i18n>filter.groupControlNumber}" labelFor="groupControlNumber" />
            <Input id="groupControlNumber" value="{view>/filters/groupControlNumber}" width="9rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.messageNumber}" labelFor="messageNumber" />
            <Input id="messageNumber" value="{view>/filters/messageNumber}" width="9rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.processingStatus}" labelFor="processingStatus" />
            <Input id="processingStatus" value="{view>/filters/processingStatus}" width="9rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.technicalAck}" labelFor="technicalAckStatus" />
            <Input id="technicalAckStatus" value="{view>/filters/technicalAckStatus}" width="9rem" submit=".onSearch" />
          </VBox>
          <VBox>
            <Label text="{i18n>filter.functionalAck}" labelFor="functionalAckStatus" />
            <Input id="functionalAckStatus" value="{view>/filters/functionalAckStatus}" width="9rem" submit=".onSearch" />
          </VBox>
        </FlexBox>

        <!-- Status tiles: one per status the tenant reports; pressing one filters the list. -->
        <HBox
          items="{view>/tiles}"
          wrap="Wrap"
          class="reportServerTiles"
          visible="{= ${view>/unavailableMessage} === '' }">
          <GenericTile
            header="{= ${view>category} === 'all' ? ${i18n>kpi.all} : ${view>status} }"
            frameType="OneByHalf"
            class="reportServerTile"
            press=".onTilePress">
            <customData>
              <core:CustomData key="status" value="{view>key}" />
              <core:CustomData
                key="active"
                value="{= ${view>key} === ${view>/filters/status} ? 'true' : 'false' }"
                writeToDom="true" />
            </customData>
            <TileContent>
              <NumericContent
                value="{view>count}"
                valueColor="{view>valueColor}"
                withMargin="false"
                animateTextChange="false" />
            </TileContent>
          </GenericTile>
        </HBox>
        <Text
          text="{i18n>kpi.truncated}"
          visible="{view>/summaryTruncated}"
          class="sapUiSmallMarginBegin reportServerHint" />

        <l:Splitter
          height="100%"
          orientation="Horizontal"
          class="reportServerSplitter"
          visible="{= ${view>/unavailableMessage} === '' }">
          <l:layoutData>
            <FlexItemData growFactor="1" baseSize="0" />
          </l:layoutData>
          <l:contentAreas>

            <!-- List -->
            <ScrollContainer height="100%" vertical="true">
              <layoutData>
                <l:SplitterLayoutData size="58%" />
              </layoutData>
              <Table
                id="table"
                items="{view>/items}"
                mode="SingleSelectMaster"
                selectionChange=".onSelect"
                busy="{view>/busy}"
                busyIndicatorDelay="0"
                sticky="ColumnHeaders"
                fixedLayout="false"
                contextualWidth="Auto"
                noDataText="{i18n>list.empty}"
                class="reportServerTable">
                <columns>
                  <Column width="9rem"><Text text="{i18n>column.status}" /></Column>
                  <Column width="10rem"><Text text="{i18n>column.started}" /></Column>
                  <Column><Text text="{i18n>column.sender}" /></Column>
                  <Column><Text text="{i18n>column.receiver}" /></Column>
                  <Column minScreenWidth="720px" demandPopin="true"><Text text="{i18n>column.document}" /></Column>
                  <Column minScreenWidth="900px"><Text text="{i18n>column.direction}" /></Column>
                </columns>
                <items>
                  <ColumnListItem type="Active">
                    <cells>
                      <ObjectStatus
                        text="{view>overallStatus}"
                        state="{path: 'view>statusCategory', formatter: '.formatter.statusState'}"
                        icon="{path: 'view>statusCategory', formatter: '.formatter.statusIcon'}" />
                      <Text text="{path: 'view>startedAt', formatter: '.fmt.dateTime'}" />
                      <Text text="{path: 'view>sender', formatter: '.formatter.partner'}" />
                      <Text text="{path: 'view>receiver', formatter: '.formatter.partner'}" />
                      <ObjectIdentifier
                        title="{path: 'view>sender', formatter: '.formatter.document'}"
                        text="{view>sender/interchangeControlNumber}" />
                      <Text text="{view>direction}" />
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
              <Toolbar class="reportServerPager" visible="{= ${view>/total} > 0 }">
                <Text text="{view>/showingText}" />
                <ToolbarSpacer />
                <Button text="{i18n>action.loadMore}" visible="{view>/hasMore}" press=".onLoadMore" />
              </Toolbar>
            </ScrollContainer>

            <!-- Detail: the shared interchange panel -->
            <ScrollContainer height="100%" vertical="true">
              <layoutData>
                <l:SplitterLayoutData size="auto" />
              </layoutData>
              <VBox class="sapUiSmallMargin" busy="{view>/detailBusy}" busyIndicatorDelay="0">
                <MessageStrip
                  text="{i18n>detail.noneSelected}"
                  type="Information"
                  showIcon="true"
                  visible="{= ${b2b>/detail} === null }" />

                <VBox visible="{= ${b2b>/detail} !== null }">
                  <HBox alignItems="Start" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                    <VBox class="reportServerDetailTitle">
                      <Title text="{= ${b2b>/detail/interchange/interchangeName} || ${b2b>/detail/interchange/id} }" level="H3" wrapping="true" />
                      <Text text="{b2b>/detail/interchange/id}" class="reportServerMono" />
                    </VBox>
                    <ObjectStatus
                      text="{b2b>/detail/interchange/overallStatus}"
                      state="{path: 'b2b>/detail/interchange/statusCategory', formatter: '.formatter.statusState'}"
                      icon="{path: 'b2b>/detail/interchange/statusCategory', formatter: '.formatter.statusIcon'}"
                      inverted="true" />
                  </HBox>
                  <IconTabBar expandable="false" class="reportServerTabs">
                    <items>
                      <core:Fragment fragmentName="com.middlewareops.integrationportal.fragment.b2b.InterchangeTabs" type="XML" />
                    </items>
                  </IconTabBar>
                </VBox>
              </VBox>
            </ScrollContainer>

          </l:contentAreas>
        </l:Splitter>
      </VBox>
    </content>
  </Page>
</mvc:View>
