<!--
  The CoE Visual Rule Builder's editor dialog — the standalone Rule Builder's chrome (title + Save /
  Cancel) around the shared `RuleEditorContent` fragment, which carries the actual editor body (bound
  to `view>/ruleEditor/*`, handlers on `RuleEditorHostController`). The route-creation wizards embed
  the same content fragment directly as a step instead of this dialog.
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    id="editorDialog"
    title="{= ${view>/ruleEditor/isNew} ? ${i18n>coeRuleBuilder.editor.newTitle} : ${i18n>coeRuleBuilder.editor.editTitle} }"
    contentWidth="50rem"
    contentHeight="42rem"
    resizable="true"
    draggable="true"
    verticalScrolling="true"
    busy="{view>/busy}"
    busyIndicatorDelay="0">
    <content>
      <core:Fragment
        fragmentName="com.middlewareops.integrationportal.view.coeRuleBuilder.RuleEditorContent"
        type="XML" />
    </content>
    <beginButton>
      <Button text="{i18n>coeRuleBuilder.editor.save}" type="Emphasized" press=".onSave" />
    </beginButton>
    <endButton>
      <Button text="{i18n>coeRuleBuilder.editor.cancel}" press=".onCloseEditor" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
