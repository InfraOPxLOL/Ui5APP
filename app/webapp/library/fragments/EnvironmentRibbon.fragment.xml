<!--
  EnvironmentRibbon (§10) — reusable environment-awareness banner.

  Binds the standardized `view>/environment` shape ({ tenantName, environmentLabel, environmentKind,
  accent, show }). Colour comes from the `opsEnv-<kind>` class the workspace controller stamps on the
  view root, so DEV / TEST / QA / PROD are never confused. Reusable by any workspace that exposes the
  same `view>/environment` model shape.
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <HBox
    class="opsEnvRibbon"
    alignItems="Center"
    justifyContent="SpaceBetween"
    width="100%">
    <items>
      <HBox alignItems="Center" class="opsEnvRibbonMain">
        <core:Icon src="sap-icon://official-service" class="opsEnvRibbonIcon" />
        <Text text="{view>/environment/environmentLabel}" class="opsEnvRibbonEnv" />
        <Text text="•" class="opsEnvRibbonSep" />
        <core:Icon src="sap-icon://cloud" class="opsEnvRibbonTenantIcon" />
        <Text text="{view>/environment/tenantName}" class="opsEnvRibbonTenant" />
      </HBox>
      <MessageStrip
        visible="{view>/environment/show}"
        type="Warning"
        showIcon="true"
        showCloseButton="false"
        text="{i18n>ops.env.nonprod}"
        class="opsEnvRibbonWarn" />
    </items>
  </HBox>
</core:FragmentDefinition>
