<!--
  Reusable confirmation dialog.
  Opened via DialogService.open({ fragmentName, data }). The `dialog` model supplies `title`,
  `message` and optional `confirmText`/`cancelText`. Event handlers are provided by the opening
  controller. This is the shared confirmation surface for destructive actions across modules.
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Dialog
    title="{dialog>/title}"
    type="Message"
    state="Warning"
    escapeHandler=".onConfirmDialogCancel">
    <content>
      <Text
        text="{dialog>/message}"
        class="sapUiSmallMargin" />
    </content>
    <beginButton>
      <Button
        text="{dialog>/confirmText}"
        type="Emphasized"
        press=".onConfirmDialogConfirm" />
    </beginButton>
    <endButton>
      <Button
        text="{dialog>/cancelText}"
        press=".onConfirmDialogCancel" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
