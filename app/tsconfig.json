{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@sapui5/types"],
    "rootDir": "webapp",
    "baseUrl": "./",
    "paths": {
      "com/middlewareops/integrationportal/*": ["./webapp/*"]
    },
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["webapp/**/*.ts"],
  "exclude": ["node_modules", "dist", "webapp/test"]
}
