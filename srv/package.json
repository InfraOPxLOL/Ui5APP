{
  "name": "@integration-portal/srv",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Node.js + Express backend for the Integration Portal. Authenticates, resolves Destinations, calls SAP Integration Suite APIs, and transforms/aggregates responses. Holds no business data.",
  "type": "module",
  "main": "gen/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env gen/server.js",
    "start:dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
